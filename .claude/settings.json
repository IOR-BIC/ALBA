{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit(/**)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git checkout -b feature/*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File tools/agent/*)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git add *)",
      "PowerShell(git checkout -b feature/*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File tools/agent/*)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "PowerShell(git commit *)",
      "PowerShell(git merge *)",
      "PowerShell(git push *)",
      "PowerShell(git reset *)",
      "PowerShell(git rebase *)"
    ]
  }
}
